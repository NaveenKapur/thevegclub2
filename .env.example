# ─── PUBLIC ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://thevegclub.com
NEXT_PUBLIC_RESERVATION_FEE=50
NEXT_PUBLIC_CONTACT_PHONE=919988119793
NEXT_PUBLIC_WHATSAPP=919988119793
NEXT_PUBLIC_GA4_ID=

# ─── CRM  (cis · pct211 · 192.168.1.211) ──────────────────────────────────
# Server-side only. Never NEXT_PUBLIC_. The browser must never see these.
CRM_BASE_URL=https://crm.radissonveg.com
CRM_API_KEY=
CRM_BOOKING_PATH=/api/public/website-reservation-form
CRM_STATUS_PATH=/api/reservations/by-ref
CRM_PUBLIC_RESERVATION_PATH=/api/public/reservations
# mock while HDFC credentials are pending; set to hdfc when the bank is live
CRM_GATEWAY=mock
CRM_DEALS_PATH=/api/public/deals
CRM_TIMEOUT_MS=8000

# ─── HERMES  (aiagents · pct103 · 192.168.1.103) ──────────────────────────
HERMES_BASE_URL=http://192.168.1.103:8080
HERMES_API_KEY=
HERMES_SEND_PATH=/api/send
HERMES_AGENT=reservations
HERMES_TIMEOUT_MS=8000

# ─── REVALIDATION ─────────────────────────────────────────────────────────
# CRM calls POST /api/revalidate with this secret when a deal changes.
REVALIDATE_SECRET=change-me
